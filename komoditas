def crop_dashboard(commodity):
    provinces = scale_provinces(commodity["factor"])
    trend = scale_trend(commodity["factor"])

    regions = ["Semua"] + sorted({p["wilayah"] for p in provinces})
    if st.session_state.region not in regions:
        st.session_state.region = "Semua"

    region = st.selectbox("Wilayah", regions, index=regions.index(st.session_state.region))
    st.session_state.region = region

    filtered = provinces if region == "Semua" else [p for p in provinces if p["wilayah"] == region]

    total_tanam = sum(p["tanam"] for p in filtered)
    total_panen = sum(p["panen"] for p in filtered)
    total_produksi = sum(p["produksi"] for p in filtered)
    avg_prod = sum(p["produktivitas"] for p in filtered) / len(filtered) if filtered else 0
    top5 = sorted(filtered, key=lambda p: p["produksi"], reverse=True)[:5]

    st.title(f"Dashboard {commodity['label']}")
    st.caption(f"Musim tanam 2026 · {len(filtered)} provinsi ditampilkan")

    c1, c2, c3, c4 = st.columns(4)
    with c1: kpi("Total luas tanam", f"{fmt(total_tanam)} Ha", "Akumulasi wilayah terpilih", "#6FBF73")
    with c2: kpi("Total luas panen", f"{fmt(total_panen)} Ha", "Capaian panen riil", "#C9A227")
    with c3: kpi("Total produksi", f"{fmt(total_produksi)} Ton", "Akumulasi hasil panen", "#7FD1FF")
    with c4: kpi("Rata-rata produktivitas", f"{avg_prod:.2f} Ton/Ha", "Provitas wilayah terpilih", "#E39A9A")

    left, right = st.columns([1.3, 1])
    with left:
        st.markdown('<div class="panel"><div class="panel-title">Tren luas tanam vs produksi</div><div class="panel-sub">Nasional, 7 musim terakhir</div></div>', unsafe_allow_html=True)
        dftrend = pd.DataFrame(trend)
        st.plotly_chart(
            plot_line(dftrend, "tahun", ["produksi", "tanam"], ["Produksi (ton)", "Luas tanam (ha)"], ""),
            use_container_width=True
        )
    with right:
        st.markdown('<div class="panel"><div class="panel-title">Peringkat produksi tertinggi</div><div class="panel-sub">Top 5 provinsi terpilih</div></div>', unsafe_allow_html=True)
        dftop = pd.DataFrame(top5)
        if not dftop.empty:
            st.plotly_chart(plot_bar(dftop, "produksi", "name", ""), use_container_width=True)

