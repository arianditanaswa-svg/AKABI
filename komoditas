def budget_data_page(commodity):
    df = pd.DataFrame(BUDGET_PROVINCES)
    st.title(f"Data wilayah — {commodity['label']}")

    query = st.text_input("🔎 Cari provinsi...", key="budget_query")
    if query:
        df = df[df["name"].str.lower().str.contains(query.lower())]

    df["serapan"] = (df["realisasi"] / df["anggaran"] * 100).round().astype(int)
    df = df.sort_values("anggaran", ascending=False)
    df["anggaran"] = df["anggaran"].map(fmt_rp)
    df["realisasi"] = df["realisasi"].map(fmt_rp)
    df = df.rename(columns={
        "name": "Provinsi",
        "anggaran": "Anggaran",
        "realisasi": "Realisasi",
        "serapan": "Serapan (%)",
    })

    st.caption(f"Rincian anggaran per provinsi · {len(df)} baris")
    st.dataframe(df[["Provinsi", "Anggaran", "Realisasi", "Serapan (%)"]],
                 use_container_width=True, hide_index=True)

