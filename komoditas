# ---------- Helpers ----------
def fmt(n):
    return f"{int(round(n)):,}".replace(",", ".")

def fmt_rp(n):
    if n is None:
        return "—"
    if n >= 1e9:
        return f"Rp {n / 1e9:.1f} M"
    if n >= 1e6:
        return f"Rp {n / 1e6:.0f} Jt"
    return f"Rp {fmt(n)}"

def scale_provinces(factor):
    rows = []
    for p in BASE_PROVINCES:
        q = p.copy()
        q["tanam"] = round(p["tanam"] * factor)
        q["panen"] = round(p["panen"] * factor)
        q["produksi"] = round(p["produksi"] * factor)
        rows.append(q)
    return rows

def scale_trend(factor):
    rows = []
    for t in BASE_TREND:
        q = t.copy()
        q["tanam"] = round(t["tanam"] * factor)
        q["produksi"] = round(t["produksi"] * factor)
        rows.append(q)
    return rows

def build_pengadaan_provinces(target_ha):
    total_share = sum(p["tanam"] for p in BASE_PROVINCES)
    rows = []
    for p in BASE_PROVINCES:
        rows.append({
            "name": p["name"],
            "targetHa": round((p["tanam"] / total_share) * target_ha),
            "skBrmp": None, "skKpa": None, "skPpk": None,
            "kontrak": None, "salur": None, "tanam": None,
            "klik": None, "nilaiKontrak": None, "spm": None, "sp2d": None,
        })
    return rows

def plot_line(df, x, series, names, title, money=False):
    fig = go.Figure()
    for col, name, dash in zip(series, names, ["solid", "solid"]):
        fig.add_trace(go.Scatter(
            x=df[x], y=df[col], mode="lines+markers",
            name=name, line=dict(width=2.5),
            marker=dict(size=6),
        ))
    fig.update_layout(
        title=title,
        height=300,
        margin=dict(l=10, r=10, t=45, b=10),
        paper_bgcolor="#153824",
        plot_bgcolor="#153824",
        font=dict(color="#F5F3EA"),
        legend=dict(orientation="h", yanchor="bottom", y=1.01),
        xaxis=dict(gridcolor="rgba(245,243,234,.08)"),
        yaxis=dict(gridcolor="rgba(245,243,234,.08)"),
    )
    if money:
        fig.update_yaxes(tickformat=",.0s")
    return fig

def plot_bar(df, value_col, name_col, title, money=False):
    d = df.sort_values(value_col, ascending=True).tail(5)
    fig = go.Figure(go.Bar(
        x=d[value_col],
        y=d[name_col],
        orientation="h",
        text=d[value_col].map(fmt_rp if money else fmt),
        textposition="outside",
    ))
    fig.update_layout(
        title=title,
        height=300,
        margin=dict(l=10, r=60, t=45, b=10),
        paper_bgcolor="#153824",
        plot_bgcolor="#153824",
        font=dict(color="#F5F3EA"),
        xaxis=dict(gridcolor="rgba(245,243,234,.08)"),
        yaxis=dict(gridcolor="rgba(245,243,234,.08)"),
    )
    return fig

